# 设置WeasyPrint所需的动态库路径（macOS）
import platform
if platform.system() == "Darwin":
    # 直接使用Homebrew已知路径
    import subprocess
    try:
        result = subprocess.run(['brew', '--prefix', 'pango'], capture_output=True, text=True)
        if result.returncode == 0:
            pango_lib_path = os.path.join(result.stdout.strip(), 'lib')
            os.environ['DYLD_LIBRARY_PATH'] = pango_lib_path
            print(f"已设置 DYLD_LIBRARY_PATH={pango_lib_path}")
    except Exception:
